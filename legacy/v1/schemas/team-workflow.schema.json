{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loop-engineering-code:team-workflow:1.0",
  "title": "Prepared team work batch",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "revision", "scope", "final_task", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "workflow_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "scope": {"type": "string", "minLength": 1},
    "final_task": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]*$"},
    "native_rework": {
      "type": "object", "additionalProperties": false, "required": ["max_rounds"],
      "description": "Opt-in bounded recovery of a failed independent review through its frozen repair_task, or a rejected current handoff through its authorized self/repair_task owner; both share original child identities, scopes and cumulative limits.",
      "properties": {"max_rounds": {"type": "integer", "minimum": 0, "maximum": 10}}
    },
    "native_parallel": {"type": "object", "additionalProperties": false,
      "required": ["max_parallel", "max_refreshes"],
      "properties": {"max_parallel": {"type": "integer", "minimum": 1, "maximum": 16},
                     "max_refreshes": {"type": "integer", "minimum": 0, "maximum": 10}}},
    "tasks": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "phase", "role", "task_file", "engine_file", "depends_on", "outputs", "handoff_to"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "phase": {"$ref": "#/$defs/id"},
          "role": {"$ref": "#/$defs/id"},
          "task_file": {"type": "string", "minLength": 1},
          "engine_file": {"type": ["string", "null"], "minLength": 1},
          "repair_task": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]*$"},
          "draft_paths": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "outputs": {"type": "array", "description": "Actual workspace-relative file paths, not descriptions. Each must already exist or be producible by this task or a dependency within its declared write scope.", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "handoff_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        }
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}}
}
