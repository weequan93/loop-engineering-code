{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loop-engineering-code:evidence:0.1",
  "title": "Loop Engineering evidence v0.1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "check_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "check_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "executor_run_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ],
      "maximum": 9007199254740991,
      "minimum": -9007199254740991
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "uri",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "task_id",
    "contract_digest",
    "snapshot_digest",
    "environment_digest",
    "check_id",
    "check_digest",
    "executor_run_id",
    "started_at",
    "finished_at",
    "result",
    "exit_code",
    "artifacts",
    "summary"
  ],
  "additionalProperties": false
}
