{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loop-engineering-code:team-policy:1.0",
  "title": "Cumulative supervised team execution policy",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "max_parallel", "max_dispatches", "max_reworks", "max_wall_seconds", "max_tokens", "max_cost_microunits", "cost_currency", "timeout_seconds", "final_reserve_tokens", "final_reserve_cost_microunits"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "max_parallel": {"type": "integer", "minimum": 1, "maximum": 8},
    "max_dispatches": {"type": "integer", "minimum": 1, "maximum": 10000},
    "max_reworks": {"type": "integer", "minimum": 0, "maximum": 100},
    "max_wall_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1800},
    "max_tokens": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
    "max_cost_microunits": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
    "cost_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "final_reserve_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "final_reserve_cost_microunits": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  }
}
