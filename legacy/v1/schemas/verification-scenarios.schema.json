{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array", "minItems": 1, "maxItems": 64,
  "items": {
    "type": "object", "additionalProperties": false,
    "required": ["id", "check_id", "surface", "title", "kind", "depends_on", "max_attempts", "timeout_seconds"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
      "check_id": {"type": "string", "minLength": 1, "maxLength": 128},
      "surface": {"type": "string", "minLength": 1, "maxLength": 128},
      "title": {"type": "string", "minLength": 1, "maxLength": 512},
      "kind": {"enum": ["capability", "acceptance"]},
      "input_modules": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
        "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}},
      "depends_on": {"type": "array", "uniqueItems": true, "maxItems": 64,
        "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}},
      "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
      "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
    }
  }
}
