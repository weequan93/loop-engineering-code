{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loop-engineering-code:questions:1.0",
  "title": "Scenario clarification record (host-maintained, not acceptance evidence)",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "questions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "questions": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "question", "reason", "blocking", "answers"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "question": {"type": "string", "minLength": 1, "maxLength": 4096},
          "reason": {"type": "string", "minLength": 1, "maxLength": 4096},
          "blocking": {"type": "boolean"},
          "answers": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 16384}}
        }
      }
    }
  }
}
