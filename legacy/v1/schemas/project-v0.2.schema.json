{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loop-engineering-code:project:0.2",
  "title": "Loop Engineering project v0.2",
  "type": "object",
  "properties": {
    "execution_tools": {"const": ".loop/execution-tools.json"},
    "schema_version": {
      "const": "0.2"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "languages": {
      "type": "array",
      "items": {
        "enum": [
          "python",
          "javascript",
          "typescript",
          "go",
          "rust",
          "unknown"
        ]
      },
      "uniqueItems": true
    },
    "commands": {
      "type": "object",
      "properties": {
        "build": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "argv": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "confirmed": {
                  "type": "boolean"
                }
              },
              "required": [
                "argv",
                "cwd",
                "timeout_seconds",
                "source",
                "confirmed"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "test": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "argv": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "confirmed": {
                  "type": "boolean"
                }
              },
              "required": [
                "argv",
                "cwd",
                "timeout_seconds",
                "source",
                "confirmed"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "lint": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "argv": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "confirmed": {
                  "type": "boolean"
                }
              },
              "required": [
                "argv",
                "cwd",
                "timeout_seconds",
                "source",
                "confirmed"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "argv": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "confirmed": {
                  "type": "boolean"
                }
              },
              "required": [
                "argv",
                "cwd",
                "timeout_seconds",
                "source",
                "confirmed"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "build",
        "test",
        "lint",
        "start"
      ],
      "additionalProperties": false
    },
    "conventions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "context_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "exclude",
        "max_file_bytes",
        "max_total_bytes"
      ],
      "additionalProperties": false
    },
    "context_max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "languages",
    "commands",
    "conventions",
    "context_paths",
    "snapshot",
    "context_max_bytes",
    "notes"
  ],
  "additionalProperties": false
}
