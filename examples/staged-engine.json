  "stages": [
    {
      "id": "fix",
      "depends_on": [],
      "criterion_ids": [
        "empty-whitespace"
      ],
      "write_allow": [
        "slug.py"
      ],
      "write_deny": []
    },
    {
      "id": "compatibility",
      "depends_on": [
        "fix"
      ],
      "criterion_ids": [
        "preserve-behavior"
      ],
      "write_allow": [
        "slug.py"
      ],
      "write_deny": []
    }
  ]
}
