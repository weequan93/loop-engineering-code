{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "modules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "modules": {"type": "array", "minItems": 1, "maxItems": 64,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["id", "paths", "depends_on"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "paths": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}},
          "depends_on": {"type": "array", "maxItems": 64, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}}
        }
      }
    }
  }
}
