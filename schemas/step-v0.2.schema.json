{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loop-engineering-code:step:0.2",
  "title": "Loop Engineering step v0.2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "step_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "base_snapshot_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "intent": {
      "enum": [
        "act",
        "request_verification",
        "need_input",
        "blocked"
      ]
    },
    "criterion_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "expected_observation": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "expected_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "new_content": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "expected_sha256",
          "new_content"
        ],
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "blocker": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "category": {
              "enum": [
                "input",
                "dependency",
                "permission",
                "capability"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "resumption_condition": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "category",
            "description",
            "resumption_condition"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "step_id",
    "task_id",
    "contract_digest",
    "base_snapshot_digest",
    "intent",
    "criterion_ids",
    "summary",
    "expected_observation",
    "changes",
    "evidence_refs",
    "blocker",
    "next_action"
  ],
  "additionalProperties": false
}
