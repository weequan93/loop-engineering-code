{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "provision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "output_dirs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 8,
          "uniqueItems": true
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 64,
                "minItems": 1
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300
              }
            },
            "required": [
              "id",
              "argv",
              "cwd",
              "timeout_seconds"
            ]
          },
          "maxItems": 8
        },
        "max_output_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      },
      "required": [
        "inputs",
        "output_dirs",
        "steps",
        "max_output_files",
        "max_output_bytes"
      ]
    },
    "executors": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "browser"
              },
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120
              },
              "node": {
                "type": "string",
                "minLength": 1
              },
              "playwright_module": {
                "type": "string",
                "minLength": 1
              },
              "browser_executable": {
                "type": "string",
                "minLength": 1
              },
              "document": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "allowed_origins": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 16,
                "uniqueItems": true
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "action": {
                      "enum": [
                        "click",
                        "fill",
                        "press",
                        "assert_text",
                        "assert_visible",
                        "assert_count"
                      ]
                    },
                    "selector": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "action",
                    "selector",
                    "value"
                  ]
                },
                "maxItems": 64,
                "minItems": 1
              },
              "viewport": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 240,
                    "maximum": 3840
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 240,
                    "maximum": 2160
                  }
                },
                "required": [
                  "width",
                  "height"
                ]
              }
            },
            "required": [
              "kind",
              "check_id",
              "timeout_seconds",
              "node",
              "playwright_module",
              "browser_executable",
              "document",
              "url",
              "allowed_origins",
              "steps",
              "viewport"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "http_load"
              },
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "allowed_origins": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 16,
                "minItems": 1,
                "uniqueItems": true
              },
              "requests": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "concurrency": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "requests_per_second": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "request_timeout_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "max_response_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "expected_status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "thresholds": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "max_p95_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 120000
                  },
                  "max_errors": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "min_successes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  }
                },
                "required": [
                  "max_p95_ms",
                  "max_errors",
                  "min_successes"
                ]
              }
            },
            "required": [
              "kind",
              "check_id",
              "timeout_seconds",
              "url",
              "allowed_origins",
              "requests",
              "concurrency",
              "requests_per_second",
              "request_timeout_ms",
              "max_response_bytes",
              "expected_status",
              "thresholds"
            ]
          }
        ]
      },
      "maxItems": 32
    }
  },
  "required": [
    "schema_version",
    "provision",
    "executors"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loop-engineering-code:execution-tools:1.0",
  "title": "Bounded project execution tools"
}
