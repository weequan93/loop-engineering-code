{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loop-engineering-code:team:1.0",
  "title": "Host-maintained team selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "basis_digest", "decisions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "basis_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "decisions": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "state", "reason", "sources", "assignee", "covered_by", "handoff_to"],
        "properties": {
          "role": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "state": {"enum": ["active", "covered", "inactive", "pending"]},
          "reason": {"type": "string", "minLength": 1},
          "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "assignee": {"type": ["string", "null"], "minLength": 1},
          "covered_by": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]*$"},
          "handoff_to": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}}
        }
      }
    }
  }
}
