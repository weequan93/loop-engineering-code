{
  "schema_version": "1.0",
  "runtime": {
    "backend": "local",
    "image": null,
    "memory_mb": 512,
    "cpu_millis": 1000,
    "pids_limit": 128,
    "tmp_mb": 128,
    "uid": 1000,
    "gid": 1000
  },
  "model": {
    "provider": "openai",
    "model": "set-your-model-id",
    "api_key_env": "OPENAI_API_KEY",
